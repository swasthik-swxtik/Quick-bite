PORT=3000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quickbite
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT secret — change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS — origin of the Vite dev server
CLIENT_ORIGIN=http://localhost:5173
